# demo — локальная тестовая площадка; live — настоящий Discord и UEX.
TRADER_MODE=demo
TRADER_DISCORD_TOKEN=
TRADER_UEX_APP_TOKEN=
TRADER_GUILD_ID=
TRADER_CHANNEL_ID=
TRADER_ROLE_ID=
# test передаёт UEX is_production=0; production разрешает реальные отправки.
TRADER_UEX_SEND_MODE=test
# Режим создания/удаления объявлений независим от сообщений. test ничего не публикует.
# production — реальная публикация/удаление только после личного подтверждения игрока.
TRADER_UEX_LISTING_MODE=test
# Оба личных ключа участника UEX вводятся через /подключить, не в общий конфиг.
# Для libretranslate запускай Compose с --profile local-translation; Groq/Azure профиль не нужен.
TRADER_TRANSLATOR=libretranslate
TRADER_AZURE_KEY=
TRADER_AZURE_REGION=
# groq — облачный перевод; для первого теста используется Groq Free.
TRADER_GROQ_API_KEY=
TRADER_GROQ_MODEL=openai/gpt-oss-120b
# Необязательно: получатель и ссылка для напоминаний о подписке. Дата задаётся админской /подписка.
TRADER_HOSTING_REMINDER_USER_ID=
TRADER_HOSTING_REMINDER_URL=
# Необязательно: ежедневный согласованный снимок SQLite без остановки, ЧЧ:ММ в TZ процесса.
TRADER_BACKUP_TIME=
