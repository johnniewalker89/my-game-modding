<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SCModLauncher</AssemblyName>
    <RootNamespace>SCModLauncher</RootNamespace>
    <Authors>johnniewalker89</Authors>
    <Copyright>Copyright (C) 2026 johnniewalker89</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>Assets\scm-launcher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\scm-launcher.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SCModLauncher.TransportTests" />
  </ItemGroup>
</Project>
